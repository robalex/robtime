# Credentials for the end-to-end tests, which drive a real Cognito login.
# Copy to .env.e2e (gitignored) and fill in, or export these in your shell.
#
# Use a dedicated test account, not your own admin login: the tests create and delete real client
# records in whatever database the API is pointed at.
E2E_EMAIL=you@example.com
E2E_PASSWORD=
