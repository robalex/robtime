# Copy to .env.local (gitignored) and fill in from your Cognito user pool.
# None of these are secrets — a SPA app client has no client secret, and the client id ships in the
# JS bundle by design. They're kept out of the repo simply because they're environment-specific.

# Applications -> Domain. Host only, no https:// and no trailing slash.
VITE_COGNITO_DOMAIN=your-prefix.auth.us-east-1.amazoncognito.com

# Applications -> App clients -> Client ID.
VITE_COGNITO_CLIENT_ID=your-app-client-id

# Optional. Defaults to /api, which the Vite dev server proxies to the local API.
# VITE_API_BASE_URL=/api
